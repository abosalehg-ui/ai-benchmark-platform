# المنصة لا تحتاج .env إلزامياً - المفاتيح تُدخل من الواجهة وتُحفظ في localStorage فقط.
# هذا الملف فقط للمطورين الذين يفضلون تشغيل اختبارات backend عبر pytest.

# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=AIza...
# OPENROUTER_API_KEY=sk-or-...
# OLLAMA_BASE_URL=http://localhost:11434

# ============================================================
# متغيّرات تشغيل الخادم (كلها اختيارية — الافتراضات تعمل محلياً)
# المرجع الكامل بالشرح في README قسم «متغيّرات البيئة».
# ============================================================

# --- الأمان ---
# API_TOKEN=                       # لو ضُبِط تُفرَض مصادقة X-API-Token على كل /api
# بدون API_TOKEN تُرفض الطلبات من خارج الجهاز بـ401: «uvicorn --host 0.0.0.0»
# سطرٌ واحد وبعده يستطيع أي جهاز في الشبكة حذف السجل. اضبط المتغيّر التالي
# على 1 إن كنت تقصد فتحها للشبكة بلا رمز.
# ALLOW_UNAUTHENTICATED_NETWORK=0
# ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# ALLOWED_UPSTREAM_HOSTS=localhost,127.0.0.1,::1,host.docker.internal

# --- تنفيذ الكود (HumanEval) ---
# auto = Docker إن وُجد وإلا subprocess. subprocess بلا عزل حقيقي: قائمته
# السوداء لا تمنع open() ولا الشبكة الصادرة — لا تستخدمه إلا مضطراً.
# SANDBOX_BACKEND=auto
# SANDBOX_DOCKER_IMAGE=python:3.11-slim
# SANDBOX_DOCKER_MEMORY=256m
# SANDBOX_DOCKER_CPUS=0.5
# SANDBOX_DOCKER_PIDS=64
# SANDBOX_SUBPROCESS_MEMORY_MB=512
# SANDBOX_SUBPROCESS_CPU_SECONDS=15
# SANDBOX_SUBPROCESS_FSIZE_MB=10

# --- التزامن والشبكة ---
# RUN_CONCURRENCY=5                # استدعاءات متوازية لكل نموذج (1-32)
# RUN_TARGET_CONCURRENCY=0         # 0 = كل النماذج بالتوازي، 1 = تسلسلي
# HTTP_MAX_CONNECTIONS=64
# HTTP_MAX_KEEPALIVE=32

# --- التشخيص ---
# LOG_LEVEL=INFO                   # المفاتيح تُنقَّح تلقائياً من اللوج
# RUN_DOCKER_TESTS=0               # 1 لتشغيل اختبارات Docker e2e
